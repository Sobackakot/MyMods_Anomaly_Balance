-- =========================================================================
-- Вспомогательные функции
-- =========================================================================

local function get_random_from_list(list)
    if not list or #list == 0 then return nil end
    return list[math.random(#list)]
end

function get_random_from_category(category_name, tier)
    local cat = loot_tables[category_name]
    if not cat then return nil end

    if not tier then
        tier = math.random(#cat)
    else
        if tier > #cat then tier = #cat end
        if tier < 1 then tier = 1 end
    end

    return get_random_from_list(cat[tier])
end

-- =========================================================================
-- Методы для вызова из других скриптов
-- =========================================================================

function get_random_pistol(tier) return get_random_from_category("pistols", tier) end
function get_random_smg(tier) return get_random_from_category("smgs", tier) end
function get_random_shotgun(tier) return get_random_from_category("shotguns", tier) end
function get_random_ar_ak(tier) return get_random_from_category("assault_rifles_ak", tier) end
function get_random_ar_vintorez(tier) return get_random_from_category("assault_rifles_vintorez", tier) end
function get_random_ar_nato(tier) return get_random_from_category("assault_rifles_nato", tier) end
function get_random_ar_heavy(tier) return get_random_from_category("assault_rifles_heavy", tier) end
function get_random_sniper(tier) return get_random_from_category("sniper_rifles", tier) end

function get_random_helmet(tier) return get_random_from_category("helmets", tier) end
function get_random_backpack(tier) return get_random_from_category("backpacks", tier) end
function get_random_outfit_light(tier) return get_random_from_category("outfits_light", tier) end
function get_random_outfit_medium_heavy(tier) return get_random_from_category("outfits_medium_heavy", tier) end
function get_random_outfit_scientific(tier) return get_random_from_category("outfits_scientific", tier) end
function get_random_outfit_exo(tier) return get_random_from_category("outfits_exo", tier) end

function get_random_tool(tier)
    local clamped_tier = math.min(math.max(tier or 1, 1), 3)
    local pool = loot_tables.tools[clamped_tier]
    
    if pool and #pool > 0 then
        return pool[math.random(#pool)]
    end
    return nil
end

function get_random_upgrade_armor(tier)
    return get_random_from_category("upgrades_armor", tier)
end

function get_random_upgrade_weapon(tier)
    return get_random_from_category("upgrades_weapon", tier)
end

-- Универсальные методы
function get_random_weapon(tier)
    local weapon_categories = {
        "pistols", "smgs", "shotguns", "assault_rifles_ak", 
        "assault_rifles_vintorez", "assault_rifles_nato", 
        "assault_rifles_heavy", "sniper_rifles"
    }
    local chosen_cat = weapon_categories[math.random(#weapon_categories)]
    return get_random_from_category(chosen_cat, tier)
end

function get_random_armor(tier)
    local armor_categories = {
        "outfits_light", "outfits_medium_heavy", 
        "outfits_scientific", "outfits_exo"
    }
    local chosen_cat = armor_categories[math.random(#armor_categories)]
    return get_random_from_category(chosen_cat, tier)
end
-- ФАЙЛ: gamedata/scripts/xr_box.script

ph_item_box_manager = nil
function get_box_manager()
    if not (ph_item_box_manager) then 
        ph_item_box_manager = ph_item_box()
    end 
    return ph_item_box_manager
end 

class "ph_item_box"
function ph_item_box:__init()
end

function ph_item_box:spawn_items(obj, who, spawn_ini)
    -- Спавним квестовые/сюжетные предметы
    if (spawn_ini) then
        create_obligatory_items(obj, spawn_ini)
    end

    local lvl_name = level.name()
    local current_tier = box_loot_config.world_level_tier[lvl_name] or 1
    
    local available_ammo = {}
    for t = 1, current_tier do
        if box_loot_config.ammo_by_tier[t] then
            for _, ammo_sec in ipairs(box_loot_config.ammo_by_tier[t]) do
                available_ammo[#available_ammo + 1] = ammo_sec
            end
        end
    end

    local target_items = math.random(1, 3) 
    
    for i = 1, target_items do
        if math.random(1, 100) <= box_loot_config.junk_spawn_chance then
            local random_junk = box_loot_config.junk_pool[math.random(#box_loot_config.junk_pool)]
            create_item_in_world(obj, random_junk, 1)
        else
            if #available_ammo > 0 then
                local random_ammo = available_ammo[math.random(#available_ammo)]
                local min_c = box_loot_config.ammo_count_range[1]
                local max_c = box_loot_config.ammo_count_range[2]
                local count = math.random(min_c, max_c)
                
                create_item_in_world(obj, random_ammo, count)
            end
        end
    end

    if math.random(1, 100) <= box_loot_config.detail_spawn_chance then
        local allowed_indices = box_loot_config.parts_by_tier[current_tier] or box_loot_config.parts_by_tier[1]
        local random_idx = allowed_indices[math.random(#allowed_indices)]
        
        local is_ballistic = (math.random(1, 2) == 1)
        local part_section = (is_ballistic and "prt_o_ballistic_" or "prt_o_retardant_") .. random_idx
        
        create_item_in_world(obj, part_section, 1)
    end
end

-- ПОЛНОСТЬЮ ИСПРАВЛЕННАЯ ФУНКЦИЯ СПАВНА
function create_item_in_world(obj, section, number)
    -- Безопасная проверка: смотрим, начинается ли название секции с "ammo_"
    local is_ammo = (string.find(section, "^ammo_") ~= nil)

    if is_ammo then
        local bad_section = section .. "_bad"
        if ini_sys:section_exist(bad_section) then
            section = bad_section
        end
    end

    -- ВАЖНО: Убрали 'not' перед cform! Предмет ДОЛЖЕН иметь cform (модель коллизии)
    if ini_sys:section_exist(section) and ini_sys:line_exist(section, "cform") then 
        local pos = vector():set(obj:position())
        pos.y = obj:position().y + 0.3
        
        if is_ammo then
            alife_create_item(section, {pos, obj:level_vertex_id(), obj:game_vertex_id()}, {ammo = number})
        else
            for i = 1, (number or 1) do
                alife_create_item(section, {pos, obj:level_vertex_id(), obj:game_vertex_id()})
            end
        end
    end
end

-- ПОЛНОСТЬЮ ИСПРАВЛЕННАЯ ФУНКЦИЯ СЮЖЕТНЫХ ПРЕДМЕТОВ
function create_obligatory_items(obj, spawn_ini)
    if not (spawn_ini and spawn_ini:line_exist("drop_box", "items")) then return end
    
    local items = parse_names(spawn_ini:r_string_ex("drop_box", "items"))
    if (#items > 0) then
        local pos = vector():set(obj:position())
        pos.y = pos.y + 0.3
            
        for i = 1, #items do
            local section = items[i]
            -- ВАЖНО: Убрали 'not' перед cform!
            if ini_sys:section_exist(section) and ini_sys:line_exist(section, "cform") then 
                alife_create_item(section, {pos, obj:level_vertex_id(), obj:game_vertex_id()})
            end
        end
    end
end
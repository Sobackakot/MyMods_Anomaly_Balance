--------------------------------------------------------------------------------
-- SURVIVE MANAGER: Модульная мультихаб-система реинкарнации (SOLID Architecture)
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- 1. КОНФИГУРАЦИЯ И РЕЕСТР УБЕЖИЩ (Open/Closed Principle)
--------------------------------------------------------------------------------
local HubRegistry = {
    cordon_sidorovich = {
        level_name     = "l01_escape",
        pos            = vector():set(-212.74, -23.19, -122.76),
        lvid           = 40973,
        gvid           = 453,
        angle          = vector():set(0, 0, 0),
        sender_name_id = "st_sidorovich",
        sender_icon    = "ui_iconsNpc_trader",
        message_key    = "st_my_sidorovich_msg",
        rescue_msg_key = "st_sleep_stalker_msg"
    },
    
    -- Пример расширения под будущие хабы:
    -- bar_dolg = { ... }
}

local HubSelector = {}
function HubSelector.select_target_hub()
    return HubRegistry.cordon_sidorovich
end

--------------------------------------------------------------------------------
-- 2. СЕРВИС УВЕДОМЛЕНИЙ (Single Responsibility Principle)
--------------------------------------------------------------------------------
local NotificationService = {}

function NotificationService.send_awakening_notices(hub)
    hub = hub or HubRegistry.cordon_sidorovich

    -- Сообщение о спасении сталкерами (через 6 секунд)
    CreateTimeEvent(0, "survive_msg_rescue_delay", 6.0, function()
        local rescue_text = game.translate_string(hub.rescue_msg_key)
        if news_manager then
            news_manager.send_tip(db.actor, rescue_text, 0, "default", 7000)
        end
        return true
    end)

    -- Сообщение от торговца/лидера хаба (через 9 секунд)
    CreateTimeEvent(0, "survive_msg_hub_delay", 9.0, function()
        local hub_text = game.translate_string(hub.message_key)
        local sender_title = game.translate_string(hub.sender_name_id)
        
        if db.actor then
            db.actor:give_game_news(sender_title, hub_text, hub.sender_icon, 0, 14000, 0)
            
            local snd = sound_object([[device\pda\pda_tip]])
            if snd then
                snd:play(db.actor, 0, sound_object.s2d)
            end
        end
        return true
    end)
end

--------------------------------------------------------------------------------
-- 3. СЕРВИС СОСТОЯНИЯ ИГРОКА (Medical & Vitals Management)
--------------------------------------------------------------------------------
local ActorStateService = {}

function ActorStateService.reset_vitals()
    if not db.actor then return end

    db.actor.health = 1.0
    db.actor.power = 1.0
    db.actor.radiation = 0.0

    if db.actor.set_psy_health then
        db.actor:set_psy_health(1.0)
    end

    local se_item = alife():create("survival_kit", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
    if se_item then
        CreateTimeEvent(0, "survive_apply_kit", 0, function()
            local cl_item = level.object_by_id(se_item.id)
            if cl_item and db.actor then
                db.actor:eat(cl_item)
                return true
            end
            return false
        end)
    end

    if actor_status_sleep and actor_status_sleep.reset_sleep_deprivation then
        actor_status_sleep.reset_sleep_deprivation()
    end

    if actor_status_sleep then
        if actor_status_sleep.thirst then actor_status_sleep.thirst = 0 end
        if actor_status_sleep.hunger then actor_status_sleep.hunger = 0 end
        if actor_status_sleep.sleep then actor_status_sleep.sleep = 0 end
    end

    for i = 1, 2000 do
        level.remove_pp_effector(i)
    end

    printf("~ [ActorStateService] Vitals successfully reset.")
end

--------------------------------------------------------------------------------
-- 4. СЕРВИС ТАЙНИКОВ И ЭКИПИРОВКИ (Stash & Gear Management)
--------------------------------------------------------------------------------
local StashService = {}

local keep_items_cache = nil
local function get_keep_items()
    if not keep_items_cache then
        local ini_stash = ini_file("items\\settings\\backpack_stash.ltx")
        keep_items_cache = utils_data.collect_section(ini_stash, "actor_backpack_keep_items", true) or {}
    end
    return keep_items_cache
end

local function is_ammo_for_wpn(sec)
    for i = 1, 3 do
        local wpn = db.actor:item_in_slot(i)
        if (wpn) then
            local ammos = utils_item.get_ammo(wpn:section(), wpn:id(), true)
            if (ammos[sec]) then return true end
        end
    end
    return false
end

local function is_in_slot(obj)
    for k,_ in pairs({ [1]=true, [2]=true, [3]=true, [7]=true, [8]=true, [13]=true }) do
        local item = db.actor:item_in_slot(k)
        if (item and item:id() == obj:id()) then return true end
    end
    return false
end

-- Изящная и абсолютно надежная проверка на ПДА по движковому классу C++[cite: 16]
local function is_device_pda(item)
    return item and (item:clsid() == clsid.device_pda)
end

local function acquire_backpack()
    local backpack = db.actor:item_in_slot(13)
    local section = "itm_actor_backpack"
    local target_item = nil

    if backpack then
        section = backpack:section()
        target_item = backpack
    else
        db.actor:iterate_inventory(function(temp, item)
            if item and not target_item then
                if item:clsid() == clsid.equ_backpack or item:section() == "itm_actor_backpack" then
                    section = item:section()
                    target_item = item
                end
            end
        end)
    end

    if target_item then
        alife_release(target_item)
    end

    return section
end

-- Перенос экипировки (оружие, броня, шлем): с защитой от захвата ПДА и расчетом износа
function StashService.transfer_equipped_gear(stash_obj)
    if not db.actor or not stash_obj then return end
    
    for _, slot_id in ipairs({1, 2, 3, 7, 8}) do
        local eq_item = db.actor:item_in_slot(slot_id)
        -- Дополнительно страхокуемся через фильтр движкового класса ПДА[cite: 16]
        if eq_item and not is_device_pda(eq_item) then
            local initial_cond = eq_item:condition()
            db.actor:transfer_item(eq_item, stash_obj)
            if initial_cond > 0.5 then
                eq_item:set_condition(math.random(20, 50) / 100)
            end
        end
    end
end

-- Перенос инвентаря с чистой движковой защитой ПДА через clsid[cite: 16]
function StashService.transfer_inventory_items(stash_obj)
    if not db.actor or not stash_obj then return end
    
    local keep_items = get_keep_items()
    db.actor:iterate_inventory(function(temp, item)
        if item and keep_items[item:section()] == nil then
            local sec = item:section()
            
            -- Пропуск ПДА на глубинном уровне независимо от слотов и названий[cite: 16]
            if not is_device_pda(item) then
                if (IsAmmo(item) ~= true) or (is_ammo_for_wpn(sec) ~= true) then
                    if ini_sys:r_bool_ex(sec, "quest_item", false) == false then
                        if db.actor:is_on_belt(item) == false and is_in_slot(item) == false then
                            db.actor:transfer_item(item, stash_obj)
                        end
                    end
                end
            end
        end
    end)
end

function StashService.create_death_stash()
    if not db.actor then return end
    
    local backpack_section = acquire_backpack()
    
    local pos = db.actor:position()
    local lvid = db.actor:level_vertex_id()
    local gvid = db.actor:game_vertex_id()

    local se_obj = alife_create("inv_backpack", pos, lvid, gvid)
    if se_obj then
        local stash_name = strformat(game.translate_string("st_itm_stash_of_character"), db.actor:character_name())
        level.map_add_object_spot_ser(se_obj.id, "treasure", stash_name)
        
        local m_data = alife_storage_manager.get_state()
        if not m_data.player_created_stashes then 
            m_data.player_created_stashes = {}
        end
        m_data.player_created_stashes[se_obj.id] = backpack_section

        local function process_transfer(id)
            local stash_obj = level.object_by_id(id)
            if stash_obj then
                StashService.transfer_equipped_gear(stash_obj)
                StashService.transfer_inventory_items(stash_obj)
                return true
            end
            return false
        end

        CreateTimeEvent(0, "survive_stash_transfer", 0, process_transfer, se_obj.id)
        actor_menu.set_msg(1, game.translate_string("st_stash_created"), 4)
        printf("~ [StashService] Death stash created at pos: x=%.2f, y=%.2f, z=%.2f", pos.x, pos.y, pos.z)
    end
end

--------------------------------------------------------------------------------
-- 5. СЕРВИС НАВИГАЦИИ (Navigation & Teleport Service)
--------------------------------------------------------------------------------
local NavigationService = {}

function NavigationService.transport_to(hub)
    if not db.actor or not hub then return end

    local current_gvid = db.actor:game_vertex_id()
    local current_level_id = game_graph():vertex(current_gvid):level_id()
    local current_level_name = alife():level_name(current_level_id)
    local target_pos = vector():set(hub.pos.x, hub.pos.y, hub.pos.z)

    if current_level_name == hub.level_name then
        db.actor:set_actor_position(target_pos)
    else
        if ChangeLevel then
            local dir = hub.angle or vector():set(0, 0, 0)
            ChangeLevel(target_pos, hub.lvid, hub.gvid, dir)
        end
    end
end

--------------------------------------------------------------------------------
-- 6. СЕРВИС КИНЕМАТОГРАФИИ (Cinematic & Effects Service)
--------------------------------------------------------------------------------
local CinematicService = {}

function CinematicService.trigger_blackout()
    if ui_sleep_dialog and ui_sleep_dialog.sleep_forced then
        ui_sleep_dialog.sleep_forced(3)
    else
        level.add_pp_effector("surge_fade.ppe", 11, false)
    end
end

--------------------------------------------------------------------------------
-- 7. ОРКЕСТРАТОР РЕИНКАРНАЦИИ (Facade Pattern)
--------------------------------------------------------------------------------
local ReincarnationManager = {
    is_dying = false
}

function ReincarnationManager.intercept_death(amount, flags)
    if flags and type(flags) == "table" then
        flags.ret_value = false
    end

    if ReincarnationManager.is_dying or db.actor:has_info("actor_is_sleeping") then
        return
    end

    ReincarnationManager.is_dying = true

    local ok, err = pcall(function()
        StashService.create_death_stash()

        if db.actor then
            db.actor.health = 1.0
        end

        CinematicService.trigger_blackout()

        local lock_ticks = 0
        CreateTimeEvent(0, "survive_iron_health_lock", 0.05, function()
            if db.actor then
                db.actor.health = 1.0
            end
            lock_ticks = lock_ticks + 1
            return lock_ticks >= 400
        end)

        local target_hub = HubSelector.select_target_hub()
        save_var(db.actor, "survive_pending_hub_key", "cordon_sidorovich")

        CreateTimeEvent(0, "survive_manager_reincarnate", 3.5, function()
            NavigationService.transport_to(target_hub)
            
            local current_gvid = db.actor:game_vertex_id()
            local current_level_name = alife():level_name(game_graph():vertex(current_gvid):level_id())
            if current_level_name == target_hub.level_name then
                ActorStateService.reset_vitals()
                NotificationService.send_awakening_notices(target_hub)
                save_var(db.actor, "survive_pending_hub_key", nil)
            end

            ReincarnationManager.is_dying = false
            return true
        end)
    end)

    if not ok then
        ReincarnationManager.is_dying = false
        printe("! [Survive Manager] Fatal error in intercept_death: %s", tostring(err))
    end
end

function ReincarnationManager.actor_on_first_update()
    local pending_key = load_var(db.actor, "survive_pending_hub_key")
    if pending_key and HubRegistry[pending_key] then
        local hub = HubRegistry[pending_key]
        
        save_var(db.actor, "survive_pending_hub_key", nil)

        CreateTimeEvent(0, "survive_cross_level_init", 0.5, function()
            ActorStateService.reset_vitals()
            NotificationService.send_awakening_notices(hub)
            return true
        end)
    end
end

--------------------------------------------------------------------------------
-- 8. ТОЧКА ВХОДА И РЕГИСТРАЦИЯ КОЛЛБЕКОВ
--------------------------------------------------------------------------------
function on_game_start()
    RegisterScriptCallback("actor_on_before_death", ReincarnationManager.intercept_death)
    RegisterScriptCallback("actor_on_first_update", ReincarnationManager.actor_on_first_update)
    printf("~ [Survive Manager] Modular SOLID Architecture successfully initialized.")
end
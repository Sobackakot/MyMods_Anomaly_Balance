--------------------------------------------------------------------------------
-- SURVIVE MANAGER: Модульная мультихаб-система реинкарнации (SOLID Architecture)
-- С поддержкой кросс-левельного сохранения состояния через Anomaly save_var
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- 1. РЕЕСТР УБЕЖИЩ И ХАБОВ (Легко масштабируется под Бар, Скадовск, Янов и т.д.)
--------------------------------------------------------------------------------
local HubRegistry = {
    cordon_sidorovich = {
        level_name     = "l01_escape",
        pos            = vector():set(-212.74, -23.19, -122.76), -- Внутри бункера
        lvid           = 40973,
        gvid           = 453,
        angle          = vector():set(0, 0, 0),
        sender_name_id = "st_sidorovich",        -- Ключ локализации имени
        sender_icon    = "ui_iconsNpc_trader",      -- Иконка Сидоровича
        message_key    = "st_my_sidorovich_msg",    -- Текст сообщения торговца
        rescue_msg_key = "st_sleep_stalker_msg"     -- Текст сообщения о спасении
    },
    
    -- Пример для будущих хабов (достаточно раскомментировать и заполнить координаты):
    -- bar_dolg = {
    --     level_name     = "l05_bar",
    --     pos            = vector():set(...),
    --     lvid           = ...,
    --     gvid           = ...,
    --     angle          = vector():set(0, 0, 0),
    --     sender_name_id = "st_barman",
    --     sender_icon    = "ui_inGame2_barman",
    --     message_key    = "st_barman_msg",
    --     rescue_msg_key = "st_sleep_stalker_msg"
    -- }
}

-- Функция выбора целевого хаба (сюда в будущем можно добавить логику поиска ближайшего)
local function select_spawn_hub()
    return HubRegistry.cordon_sidorovich
end

--------------------------------------------------------------------------------
-- 2. СЕРВИС УВЕДОМЛЕНИЙ (Динамический, зависит от хаба)
--------------------------------------------------------------------------------
local NotificationService = {}

function NotificationService.send_awakening_notices(hub)
    hub = hub or HubRegistry.cordon_sidorovich

    -- 1. Сообщение о спасении сталкерами (через 6 секунд после пробуждения)
    CreateTimeEvent(0, "survive_msg_rescue_delay", 6.0, function()
        local rescue_text = game.translate_string(hub.rescue_msg_key)
        if news_manager then
            news_manager.send_tip(db.actor, rescue_text, 0, "default", 7000)
        end
        return true
    end)

    -- 2. Сообщение от лидера/торговца хаба (через 9 секунд)
    CreateTimeEvent(0, "survive_msg_hub_delay", 9.0, function()
        local hub_text = game.translate_string(hub.message_key)
        local sender_title = game.translate_string(hub.sender_name_id)
        
        if db.actor then
            db.actor:give_game_news(
                sender_title,
                hub_text,
                hub.sender_icon,
                0,
                14000,
                0
            )
            
            local snd = sound_object([[device\pda\pda_tip]])
            if snd then
                snd:play(db.actor, 0, sound_object.s2d)
            end
        end
        return true
    end)
end

--------------------------------------------------------------------------------
-- 3. СЕРВИС СОСТОЯНИЯ ИГРОКА (Полевая стабилизация и скрытый мед-кит)
--------------------------------------------------------------------------------
local ActorStateService = {}

function ActorStateService.reset_vitals()
    if not db.actor then return end

    db.actor.health = 1.0
    db.actor.power = 1.0
    db.actor.radiation = 0.0

    if db.actor.set_psy_health then
        db.actor:set_psy_health(1.0)
    end

    -- Выдача и скрытое применение элитного полевого набора для запуска метаболизма
    local se_item = alife():create("survival_kit", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
    if se_item then
        CreateTimeEvent(0, "survive_apply_kit", 0, function()
            local cl_item = level.object_by_id(se_item.id)
            if cl_item and db.actor then
                db.actor:eat(cl_item)
                return true
            end
            return false
        end)
    end

    if actor_status_sleep and actor_status_sleep.reset_sleep_deprivation then
        actor_status_sleep.reset_sleep_deprivation()
    end

    if actor_status_sleep then
        if actor_status_sleep.thirst then actor_status_sleep.thirst = 0 end
        if actor_status_sleep.hunger then actor_status_sleep.hunger = 0 end
        if actor_status_sleep.sleep then actor_status_sleep.sleep = 0 end
    end

    for i = 1, 2000 do
        level.remove_pp_effector(i)
    end

    printf("~ [ActorStateService] Vitals reset and field kit applied.")
end

--------------------------------------------------------------------------------
-- 4. СЕРВИС НАВИГАЦИИ И ТЕЛЕПОРТАЦИИ
--------------------------------------------------------------------------------
local NavigationService = {}

function NavigationService.transport_to(hub)
    if not db.actor or not hub then return end

    local current_gvid = db.actor:game_vertex_id()
    local current_level_id = game_graph():vertex(current_gvid):level_id()
    local current_level_name = alife():level_name(current_level_id)
    local target_pos = vector():set(hub.pos.x, hub.pos.y, hub.pos.z)

    if current_level_name == hub.level_name then
        db.actor:set_actor_position(target_pos)
    else
        if ChangeLevel then
            local dir = hub.angle or vector():set(0, 0, 0)
            ChangeLevel(target_pos, hub.lvid, hub.gvid, dir)
        end
    end
end

--------------------------------------------------------------------------------
-- 5. СЕРВИС КИНЕМАТОГРАФИЧНОГО СНА (Blackout)
--------------------------------------------------------------------------------
local CinematicService = {}

function CinematicService.trigger_sleep(hours)
    if ui_sleep_dialog and ui_sleep_dialog.sleep_forced then
        ui_sleep_dialog.sleep_forced(hours)
    else
        level.add_pp_effector("surge_fade.ppe", 11, false)
    end
end

--------------------------------------------------------------------------------
-- 6. ОРКЕСТРАТОР РЕИНКАРНАЦИИ И ПЕРСИСТЕНТНЫЙ ХЕНДЛЕР (Facade Pattern)
--------------------------------------------------------------------------------
local ReincarnationManager = {
    is_dying = false
}

function ReincarnationManager.intercept_death(amount, flags)
    if flags and type(flags) == "table" then
        flags.ret_value = false
    end

    if ReincarnationManager.is_dying or db.actor:has_info("actor_is_sleeping") then
        return
    end

    ReincarnationManager.is_dying = true

    local ok, err = pcall(function()
        if db.actor then
            db.actor.health = 1.0
        end

        CinematicService.trigger_sleep(3)

        -- Защитный замок здоровья на 20 секунд
        local lock_ticks = 0
        CreateTimeEvent(0, "survive_iron_health_lock", 0.05, function()
            if db.actor then
                db.actor.health = 1.0
            end
            lock_ticks = lock_ticks + 1
            return lock_ticks >= 400
        end)

        -- Выбираем хаб и сохраняем его ключ в персистентное хранилище движка (переживает смену уровня!)
        local target_hub = select_spawn_hub()
        save_var(db.actor, "survive_pending_hub_key", "cordon_sidorovich")

        -- Таймер телепортации по истечении затухания
        CreateTimeEvent(0, "survive_manager_reincarnate", 3.5, function()
            NavigationService.transport_to(target_hub)
            
            -- Если телепорт локальный (на той же карте), применяем виталы сразу и чистим вар
            local current_gvid = db.actor:game_vertex_id()
            local current_level_name = alife():level_name(game_graph():vertex(current_gvid):level_id())
            if current_level_name == target_hub.level_name then
                ActorStateService.reset_vitals()
                NotificationService.send_awakening_notices(target_hub)
                save_var(db.actor, "survive_pending_hub_key", nil)
            end

            ReincarnationManager.is_dying = false
            return true
        end)
    end)

    if not ok then
        ReincarnationManager.is_dying = false
        printe("! [Survive Manager] Fatal error in intercept_death: %s", tostring(err))
    end
end

-- Срабатывает при появлении игрока на новом уровне (после завершения загрузки)
function ReincarnationManager.actor_on_first_update()
    local pending_key = load_var(db.actor, "survive_pending_hub_key")
    if pending_key and HubRegistry[pending_key] then
        local hub = HubRegistry[pending_key]
        
        -- Очищаем ключ сразу, чтобы триггер сработал ровно один раз
        save_var(db.actor, "survive_pending_hub_key", nil)

        -- Небольшая пауза (0.5 сек) для стабильности физики и коллизий после загрузочного экрана
        CreateTimeEvent(0, "survive_cross_level_init", 0.5, function()
            ActorStateService.reset_vitals()
            NotificationService.send_awakening_notices(hub)
            return true
        end)
    end
end

--------------------------------------------------------------------------------
-- 7. ТОЧКА ВХОДА
--------------------------------------------------------------------------------
function on_game_start()
    RegisterScriptCallback("actor_on_before_death", ReincarnationManager.intercept_death)
    RegisterScriptCallback("actor_on_first_update", ReincarnationManager.actor_on_first_update)
    printf("~ [Survive Manager] Persistent Multi-Hub Reincarnation System initialized.")
end
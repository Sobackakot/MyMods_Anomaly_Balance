--------------------------------------------------------------------------------
-- SURVIVE MANAGER: Модульная система реинкарнации (SOLID Architecture)
-- Срежиссировано под полевое восстановление и отложенные сообщения КПК
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- 1. КОНФИГУРАЦИЯ (Open/Closed Principle)
--------------------------------------------------------------------------------
local Config = {
    spawn = {
        level_name = "l01_escape",
        pos        = vector():set(-211.4, -19.8, -136.5),
        lvid       = 11575,
        gvid       = 58,
        angle      = vector():set(0, 0, 0)
    },
    unconscious_hours = 3,
    unconscious_delay = 3.5
}

--------------------------------------------------------------------------------
-- 2. СЕРВИС УВЕДОМЛЕНИЙ (С отложенной отправкой по таймерам)
--------------------------------------------------------------------------------
local NotificationService = {}

function NotificationService.send_awakening_notices()
  -- 1. Сообщение о спасении сталкерами (через 6 секунд после пробуждения)
    CreateTimeEvent(0, "survive_msg_rescue_delay", 6.0, function()
        local ms_sleep = game.translate_string("st_sleep_stalker_msg")
        if news_manager then
            news_manager.send_tip(db.actor, ms_sleep, 0, "default", 7000)
        end
        return true
    end)

    -- 2. Сообщение от Сидоровича (через 9 секунд)
     CreateTimeEvent(0, "survive_msg_sidorov_delay", 9.0, function()
        local ms_sidorov = game.translate_string("st_my_sidorovich_msg")
        
        if db.actor then
            -- Используем прямой движковый метод
            db.actor:give_game_news(
                game.translate_string("st_sidorovich"),  -- Заголовок: "Сидорович"
                ms_sidorov,                             -- Текст сообщения
                "ui_iconsNpc_trader",                   -- ТОЧНОЕ ИМЯ ТЕКСТУРЫ ИЗ ТВОЕГО NEWS_MANAGER!
                0,                                      -- Задержка в мс
                7000,                                   -- Время показа (7 секунд)
                0                                       -- Тип сообщения
            )
            
            -- Звук прихода сообщения в КПК
            local snd = sound_object([[device\pda\pda_tip]])
            if snd then
                snd:play(db.actor, 0, sound_object.s2d)
            end
        end
        return true
    end)
end
--------------------------------------------------------------------------------
-- 3. СЕРВИС СОСТОЯНИЯ ИГРОКА (Полевая стабилизация)
--------------------------------------------------------------------------------
local ActorStateService = {}

function ActorStateService.reset_vitals()
    if not db.actor then return end

    -- Базовые движковые показатели
    db.actor.health = 1.0
    db.actor.power = 1.0
    db.actor.radiation = 0.0

    if db.actor.set_psy_health then
        db.actor:set_psy_health(1.0)
    end

    -- Выдача и скрытое применение элитного полевого набора для старта метаболизма
    local se_item = alife():create("survival_kit", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
    if se_item then
        CreateTimeEvent(0, "survive_apply_kit", 0, function()
            local cl_item = level.object_by_id(se_item.id)
            if cl_item and db.actor then
                db.actor:eat(cl_item)
                return true
            end
            return false
        end)
    end

    -- Сброс депривации сна (из actor_status_sleep.script)
    if actor_status_sleep and actor_status_sleep.reset_sleep_deprivation then
        actor_status_sleep.reset_sleep_deprivation()
    end

    -- Сброс голода, жажды и усталости
    if actor_status_sleep then
        if actor_status_sleep.thirst then actor_status_sleep.thirst = 0 end
        if actor_status_sleep.hunger then actor_status_sleep.hunger = 0 end
        if actor_status_sleep.sleep then actor_status_sleep.sleep = 0 end
    end

    -- Первичная зачистка резких постэффектов боли
    for i = 1, 2000 do
        level.remove_pp_effector(i)
    end

    printf("~ [ActorStateService] Vitals reset and field kit applied.")
end

--------------------------------------------------------------------------------
-- 4. СЕРВИС НАВИГАЦИИ И ТЕЛЕПОРТАЦИИ
--------------------------------------------------------------------------------
local NavigationService = {}

local function teleport_local(pos)
    db.actor:set_actor_position(pos)
end

local function change_level_global(gvid, lvid, pos, angle)
    local p = net_packet()
    p:w_begin(13)
    p:w_u16(gvid)
    p:w_u32(lvid)
    p:w_vec3(pos)
    p:w_vec3(angle)
    level.send(p, true)
end

function NavigationService.transport_to_spawn()
    local current_gvid = db.actor:game_vertex_id()
    local current_level_id = game_graph():vertex(current_gvid):level_id()
    local current_level_name = alife():level_name(current_level_id)

    if current_level_name == Config.spawn.level_name then
        teleport_local(Config.spawn.pos)
    else
        change_level_global(Config.spawn.gvid, Config.spawn.lvid, Config.spawn.pos, Config.spawn.angle)
    end
end

--------------------------------------------------------------------------------
-- 5. СЕРВИС КИНЕМАТОГРАФИЧНОГО СНА (Blackout / Sleep)
--------------------------------------------------------------------------------
local CinematicService = {}

function CinematicService.trigger_sleep(hours)
    if ui_sleep_dialog and ui_sleep_dialog.sleep_forced then
        ui_sleep_dialog.sleep_forced(hours)
    else
        level.add_pp_effector("surge_fade.ppe", 11, false)
    end
end

--------------------------------------------------------------------------------
-- 6. ОРКЕСТРАТОР РЕИНКАРНАЦИИ (Facade Pattern)
--------------------------------------------------------------------------------
local ReincarnationManager = {
    is_dying = false
}

function ReincarnationManager.intercept_death(amount, flags)
    if flags and type(flags) == "table" then
        flags.ret_value = false
    end

    if ReincarnationManager.is_dying or db.actor:has_info("actor_is_sleeping") then
        return
    end

    ReincarnationManager.is_dying = true

    local ok, err = pcall(function()
        -- 1. Срочно фиксируем здоровье на максимум с самого первого кадра смерти
        if db.actor then
            db.actor.health = 1.0
        end

        -- Запуск затухания и сна
        CinematicService.trigger_sleep(Config.unconscious_hours)

        -- 2. ЖЕЛЕЗОБЕТОННЫЙ ЗАМОК ЗДОРОВЬЯ НА 20 СЕКУНД
        local lock_ticks = 0
        CreateTimeEvent(0, "survive_iron_health_lock", 0.05, function()
            if db.actor then
                db.actor.health = 1.0
            end
            lock_ticks = lock_ticks + 1
            return lock_ticks >= 400
        end)

        -- Основной таймер реинкарнации (телепорт и применение набора на базе)
        CreateTimeEvent(0, "survive_manager_reincarnate", Config.unconscious_delay, function()
            NavigationService.transport_to_spawn()
            ActorStateService.reset_vitals()
            
            -- Запуск отложенных сообщений после пробуждения
            NotificationService.send_awakening_notices()

            ReincarnationManager.is_dying = false
            return true
        end)
    end)

    if not ok then
        ReincarnationManager.is_dying = false
        printe("! [Survive Manager] Fatal error in intercept_death: %s", tostring(err))
    end
end

function reset_sleep_deprivation()
    if not feature_state then return end
    last_sleep = 0
    level.remove_pp_effector(39568)
end

--------------------------------------------------------------------------------
-- 7. ТОЧКА ВХОДА
--------------------------------------------------------------------------------
function on_game_start()
    RegisterScriptCallback("actor_on_before_death", ReincarnationManager.intercept_death)
    printf("~ [Survive Manager] Ironclad Reincarnation System initialized.")
end
-- ============================================================
-- Единый менеджер динамического лута (Модульная архитектура)
-- ============================================================

-- ============================================================
-- MODULE 1: Config & Constants
-- ============================================================
local Config = {
    
    enable_debug = false,
    -- 3 игровых суток = 72 игровых часа = 259200 игровых секунд.
    respawn_time_sec = 86400,
    -- Шанс успешного респавна предмета после истечения КД (в процентах: 1 - 100)
    respawn_chance = 20,
    Phases = {
        INITIAL_READY  = 1, -- Первый гарантированный предмет еще не создавался.
        ACTIVE_INITIAL = 2, -- На точке находится первый гарантированный предмет.
        COOLDOWN       = 3, -- Предмет забран, идет 3-дневный cooldown.
        RESPAWN_READY  = 4, -- Cooldown истек, можно создавать random item.
        ACTIVE_RANDOM  = 5  -- На точке находится random respawn.
    },
    
    major_levels = {
        "l01_escape", "k01_darkscape", "y04_pole", "k00_marsh", "l02_garbage",
        "l03_agroprom", "l03u_agr_underground", "l04_darkvalley", "l04u_labx18",
        "k02_trucks_cemetery", "l05_bar", "l06_rostok", "l09_deadcity", "l08_yantar",
        "l08u_brainlab", "l07_military", "l10_red_forest", "l10_limansk", "l10_radar",
        "l10u_bunker", "zaton", "jupiter", "jupiter_underground", "pripyat", "labx8",
        "l11_pripyat", "l11_hospital", "l12_stancia", "l12_stancia_2", "l13_generators"
    }
}

local PhaseNames = {
    [Config.Phases.INITIAL_READY]  = "INITIAL_READY",
    [Config.Phases.ACTIVE_INITIAL] = "ACTIVE_INITIAL",
    [Config.Phases.COOLDOWN]       = "COOLDOWN",
    [Config.Phases.RESPAWN_READY]  = "RESPAWN_READY",
    [Config.Phases.ACTIVE_RANDOM]  = "ACTIVE_RANDOM"
}

local function print_debug(fmt, ...)
    if Config.enable_debug then printf("[DYN_LOOT] " .. fmt, ...) end
end


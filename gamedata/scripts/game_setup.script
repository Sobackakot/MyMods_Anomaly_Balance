function LootTables.get_tier(level_name) return LootTables.world_level_tier[level_name] or 1 end
function LootTables.pick(list) return (list and #list > 0) and list[math.random(#list)] or nil end

-- ============================================================
-- MODULE 3: State Management (Persistence & Runtime)
-- ============================================================
local State = {
    is_inited = false,
    world_itm_info = {},   -- Статические данные спавнов
    point_state = {},      -- Состояние конечного автомата
    world_itm_on = {},     -- object_id -> point_name
    world_itm_num = {},    -- point_name -> uses/condition
    limited_uses = {},
    legacy_coords = nil
}

function State.ensure_point(name)
    local state = State.point_state[name]
    if not state then
        state = { phase = Config.Phases.INITIAL_READY, guaranteed_used = false, guaranteed_section = nil, looted_time = nil, active_id = nil }
        State.point_state[name] = state
    end
    if state.phase == nil then state.phase = Config.Phases.INITIAL_READY end
    if state.guaranteed_used == nil then state.guaranteed_used = false end
    return state
end

function State.make_time()
    local y, m, d, h, min, sec, ms = game.get_game_time():get()
    return { Y = y, M = m, D = d, h = h, m = min, s = sec, ms = ms or 0 }
end

function State.is_cooldown_finished(state)
    if not state.looted_time then return true end
    local lt = state.looted_time
    local t = game.CTime()
    t:set(lt.Y, lt.M, lt.D, lt.h, lt.m, lt.s, lt.ms or 0)
    return game.get_game_time():diffSec(t) >= Config.respawn_time_sec
end

-- ============================================================
-- MODULE 4: Guarantee Manager (Fixes the duplicate bug)
-- ============================================================
local GuaranteeManager = {}

function GuaranteeManager.sort_points(points)
    local prio = { ammo = 1, misc = 2, medical = 3, food = 4, drink = 5, kit = 6 }
    table.sort(points, function(a, b)
        local ia, ib = State.world_itm_info[a], State.world_itm_info[b]
        local ka = (ia.orig_typ == "kit") and 0 or 1
        local kb = (ib.orig_typ == "kit") and 0 or 1
        if ka ~= kb then return ka < kb end
        local pa, pb = prio[ia.orig_typ] or 99, prio[ib.orig_typ] or 99
        if pa == pb then return a < b end
        return pa < pb
    end)
end

function GuaranteeManager.assign()
   
end

-- ============================================================
-- MODULE 5: Spawner Logic
-- ============================================================
local Spawner = {}

function Spawner.select_section(name, info, state)
    -- Игнорируем гаранты, даже если они остались в старом сохранении.
    if state.phase ~= Config.Phases.INITIAL_READY and state.phase ~= Config.Phases.RESPAWN_READY then
        return nil
    end

    -- Обычный спавн (только медикаменты, расходники и хлам)
    local tier = LootTables.get_tier(info.level)
    local sec
    if info.orig_typ == "medical" then
        sec = LootTables.pick(LootTables.medical_by_tier[tier] or LootTables.medical_by_tier[1])
    else
        sec = LootTables.pick(LootTables.consumable_by_tier[tier] or LootTables.consumable_by_tier[1])
        if math.random(1, 100) <= 15 then
            sec = LootTables.pick(LootTables.junk_items_list) or sec
        end
    end
    return sec
end

function Spawner.create_item(name, info, state, section)
    if not section or not ini_sys:section_exist(section) then return false end

    local pos = vector():set(info.x, info.y, info.z)
    local se_obj = alife_create_item(section, { pos, info.lvl_id, info.gm_id })
    if not se_obj then return false end

    State.world_itm_on[se_obj.id] = name
    state.active_id = se_obj.id

    -- Всегда переводим точку в режим обычного лута, так как гарантов больше нет
    if state.phase == Config.Phases.INITIAL_READY or state.phase == Config.Phases.RESPAWN_READY then
        state.phase = Config.Phases.ACTIVE_RANDOM
    end

    -- Конфигурация состояния (патроны, состояние предмета)
    if State.limited_uses[section] then
        State.world_itm_num[name] = math.random(State.limited_uses[section][1], State.limited_uses[section][2])
    elseif utils_item.is_degradable(nil, section) then
        State.world_itm_num[name] = IsItem("part", section) and random_choice(0.5, 0.75, 1) or (math.random(30, 70) / 100)
    else
        State.world_itm_num[name] = nil
    end

    print_debug("[%s] Спавн предмета: %s", name, section)
    return true
end

function Spawner.populate_level()
    local cur_lvl = level.name()
    for name, info in pairs(State.world_itm_info) do
        if info.level == cur_lvl then
            local state = State.ensure_point(name)
            
            -- Проверка окончания КД
            if state.phase == Config.Phases.COOLDOWN then
                if State.is_cooldown_finished(state) then
                    -- Бросаем кубик (20% шанс)
                    if math.random(1, 100) <= (Config.respawn_chance or 20) then
                        state.looted_time = nil
                        state.phase = Config.Phases.RESPAWN_READY
                        print_debug("[%s] Кулдаун завершен: УСПЕХ (%d%%). Точка готова к спавну.", name, Config.respawn_chance)
                    else
                        -- Не повезло: перезапускаем 3-дневный таймер КД
                        state.looted_time = State.make_time()
                        print_debug("[%s] Кулдаун завершен: НЕУДАЧА (%d%%). Перезапуск КД на следующий цикл.", name, Config.respawn_chance)
                    end
                end
            end

            -- Спавн предмета (для первички или успешного респавна)
            if state.phase == Config.Phases.INITIAL_READY or state.phase == Config.Phases.RESPAWN_READY then
                local section = Spawner.select_section(name, info, state)
                if section then Spawner.create_item(name, info, state, section) end
            end
        end
    end
end
-- ============================================================
-- MODULE 6: Core Manager & Callbacks
-- ============================================================
local Manager = {}

function Manager.parse_config()
    local ini = ini_file("items\\settings\\dynamic_item_spawn.ltx")
    for i = 0, (ini:line_count("levels") or 0) - 1 do
        local _, id, _ = ini:r_line_ex("levels", i, "", "")
        for ii = 0, (ini:line_count(id) or 0) - 1 do
            local _, name, info = ini:r_line_ex(id, ii, "", "")
            local t = str_explode(info, ",")
            if #t == 6 and t[1] ~= "NA" then
                State.world_itm_info[name] = {
                    typ = "kit", orig_typ = t[1], level = id,
                    orig_x = tonumber(t[2]), orig_y = tonumber(t[3]), orig_z = tonumber(t[4]),
                    x = tonumber(t[2]), y = tonumber(t[3]), z = tonumber(t[4]),
                    lvl_id = tonumber(t[5]), gm_id = tonumber(t[6])
                }
                State.ensure_point(name)
            end
        end
    end
    for i = 0, (ini:line_count("possible_uses") or 0) - 1 do
        local _, id, val = ini:r_line_ex("possible_uses", i, "", "")
        local t = str_explode(val, ",")
        State.limited_uses[id] = { tonumber(t[1]) or 1, tonumber(t[2]) or 1 }
    end
end

function Manager.init()
    if State.is_inited then return end
    State.is_inited = true

    Manager.parse_config()
    
    -- Восстанавливаем координаты из сейва, если есть
    if State.legacy_coords then
        for name, c in pairs(State.legacy_coords) do
            if State.world_itm_info[name] then
                State.world_itm_info[name].x = c.x
                State.world_itm_info[name].y = c.y
                State.world_itm_info[name].z = c.z
            end
        end
    end

    -- Распределяем гаранты (безопасно, без дубликатов благодаря новой проверке)
    GuaranteeManager.assign()

    -- Восстанавливаем связи активных предметов
    for name, st in pairs(State.point_state) do st.active_id = nil end
    for obj_id, name in pairs(State.world_itm_on) do
        local st = State.point_state[name]
        if st then st.active_id = obj_id end
    end
end

function actor_on_first_update()
    Manager.init()
    Spawner.populate_level()
end

function actor_on_item_take(obj)
    if not obj then return end
    local id = obj:id()
    local name = State.world_itm_on[id]
    if not name then return end

    local state = State.point_state[name]
    local section = obj:section()

    state.looted_time = State.make_time()
    state.phase = Config.Phases.COOLDOWN
    state.active_id = nil
    State.world_itm_on[id] = nil

    local num = State.world_itm_num[name]
    if num then
        if State.limited_uses[section] then alife_process_item(section, id, { uses = num })
        elseif utils_item.is_degradable(nil, section) then alife_process_item(section, id, { cond = num }) end
        State.world_itm_num[name] = nil
    end

    itms_manager.send_itm_msg(section)
    print_debug("Залутан %s. Точка ушла в КД.", section)
end

function save_state(m_data)
    m_data.dyn_loot_state_version = 2
    m_data.dyn_loot_point_state = State.point_state
    m_data.dyn_loot_world_itm_on = State.world_itm_on
    m_data.dyn_loot_world_itm_num = State.world_itm_num
    
    local coords = {}
    for name, info in pairs(State.world_itm_info) do
        coords[name] = { x = info.x, y = info.y, z = info.z }
    end
    m_data.dyn_loot_coords = coords
end

function load_state(m_data)
    State.point_state = m_data.dyn_loot_point_state or {}
    State.world_itm_on = m_data.dyn_loot_world_itm_on or m_data.world_itm_on or {}
    State.world_itm_num = m_data.dyn_loot_world_itm_num or m_data.world_itm_num or {}
    State.legacy_coords = m_data.dyn_loot_coords or m_data.world_itm_coords
    
    if State.is_inited then Manager.init() end
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
end

-- ============================================================
-- Экспорт функций для совместимости с xr_gather_items.script
-- ============================================================
function is_world_item(id)
    return State.world_itm_on[id] ~= nil
end

function get_item_nums(name)
    return State.world_itm_num[name]
end
    {"gauss",      5},
    {"pkm",        4}, {"magnum_300", 4}, {"12%.7x55", 4},
    {"og%-7b",     3}, {"ied",        3}, {"9x39",     3}, {"7%.62x54", 3}, {"7%.62x51", 3}, {"7%.92x33", 3},
